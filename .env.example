# Copy this file to .env and fill in your values
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# ── PostgreSQL database ───────────────────────────────────────────────────
DB_NAME=momo_fraud
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ── Frontend URL (used in email links for password reset and abroad verify) ─
# Development default shown below. Change to your deployed URL in production.
FRONTEND_URL=http://localhost:5173

# ── EmailJS Private Key (for backend email sending) ──────────────────────
# Get this from: emailjs.com → Account → API Settings → Use Private Key
# Also enable "Allow EmailJS API for non-browser applications" on that page.
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
